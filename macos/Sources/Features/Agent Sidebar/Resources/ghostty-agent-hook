#!/bin/sh
# agent-sidebar: reports a coding agent's state to the Ghostty sidebar.
#
#   ghostty-agent-hook <agent> <state> [nopayload]
#
#   agent   claude | codex | gemini | copilot | opencode | aider
#   state   working | waiting | done | idle | ended
#
# The agent's hook system runs this with the hook input (JSON) on stdin. The
# script finds the terminal (tty) the agent runs in and writes
#   ~/.ghostty-agents/status/<tty>.json
# which the sidebar reads once a second. `ended` removes the file.
#
# It must never break the agent: it prints nothing and always exits 0.

agent="${1:-claude}"
state="${2:-working}"
dir="${GHOSTTY_AGENTS_DIR:-$HOME/.ghostty-agents}/status"

# Always drain stdin so the agent never blocks on a full pipe. `nopayload` is
# for frequent events (every tool call) whose input can be large.
payload="null"
if [ ! -t 0 ]; then
  if [ "${3:-}" = "nopayload" ]; then
    # Keep only the session id: it starts the input, the rest can be large.
    head="$({ head -c 4096; cat >/dev/null; } 2>/dev/null)"
    sid="$(printf '%s' "$head" | LC_ALL=C sed -n 's/.*"session_id"[ ]*:[ ]*"\([A-Za-z0-9_-]*\)".*/\1/p' 2>/dev/null | head -n 1)"
    # The first "cwd" is the session's; it is copied as the JSON string it is.
    cwd=""
    rest="${head#*\"cwd\":\"}"
    if [ "$rest" != "$head" ]; then
      cwd="$(printf '%s' "$rest" | LC_ALL=C sed -E -n '1s/^(([^"\\]|\\.)*)".*/\1/p' 2>/dev/null)"
    fi
    if [ -n "$sid" ] && [ -n "$cwd" ]; then
      payload="{\"session_id\":\"$sid\",\"cwd\":\"$cwd\"}"
    elif [ -n "$sid" ]; then
      payload="{\"session_id\":\"$sid\"}"
    fi
  else
    payload="$(cat 2>/dev/null)"
  fi
fi
case "$payload" in
  "{"*) ;;
  *) payload="null" ;;
esac

# Notifications that ask nothing of the user must not replace the state.
if [ "$state" = "waiting" ]; then
  case "$payload" in
    *'"notification_type":"idle_prompt"'* | *'"notification_type":"auth_success"'* | \
    *'"notification_type":"agent_completed"'* | *'"notification_type":"quota_'* | \
    *'"notification_type":"elicitation_complete"'* | *'"notification_type":"elicitation_response"'*) exit 0 ;;
  esac
fi

# Hooks run without a controlling terminal of their own, so walk up the
# process tree until an ancestor (the agent or its shell) has one.
pid=$$
tty=""
i=0
while [ "$i" -lt 10 ] && [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null; do
  t="$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')"
  case "$t" in
    "" | "?" | "??" | "-") ;;
    *) tty="$t"; break ;;
  esac
  pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
  i=$((i + 1))
done
[ -n "$tty" ] || exit 0

name="$(basename "$tty")"
name="$(printf '%s' "$name" | tr -c 'A-Za-z0-9_.-' '_')"
file="$dir/$name.json"

# Compaction restarts the session but not the turn: keep the state it had.
if [ "$state" = "idle" ] && [ -f "$file" ]; then
  case "$payload" in
    *'"source":"compact"'*) exit 0 ;;
  esac
fi

if [ "$state" = "ended" ]; then
  rm -f "$file" 2>/dev/null
  exit 0
fi

mkdir -p "$dir" 2>/dev/null || exit 0
tmp="$file.$$.tmp"
if printf '{"agent":"%s","state":"%s","ts":%s,"tty":"%s","payload":%s}\n' \
  "$agent" "$state" "$(date +%s)" "$name" "$payload" >"$tmp" 2>/dev/null; then
  mv -f "$tmp" "$file" 2>/dev/null || rm -f "$tmp" 2>/dev/null
fi
exit 0
